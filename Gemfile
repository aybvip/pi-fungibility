source "https://rubygems.org"

# Pinned to the exact plugin set GitHub Pages uses, so the mirror build
# produces byte-compatible output with what aybvip.github.io serves.
#
# GitHub Pages runs this same set server-side and ignores this file, so it
# has no effect on the canonical host — it exists only for the mirrors.
gem "github-pages", group: :jekyll_plugins
