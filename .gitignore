# Jekyll build output — regenerated on every build, never committed.
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Bundler (Netlify / Cloudflare Pages install gems here when using a path)
vendor/
.bundle/

node_modules/

# local scratch — never committed (editor / agent helper files)
_msg.txt
_*.mjs

# OS
Thumbs.db
.DS_Store
